#!/usr/bin/env bash
# curl stub for tests (see README.md).
set -euo pipefail

printf 'curl %s\n' "$*" >>"${NS_STUB_LOG:-/dev/null}"
# Like real curl, read ~/.curlrc unless -q is the first argument. Only `verbose` together
# with `stderr -` is emulated: the config read on stdin is echoed to stdout, as curl's
# verbose header dump would be.
leak=0
if [ "${1:-}" != -q ] && [ -f "${HOME:-/nonexistent}/.curlrc" ] &&
  grep -qx 'verbose' "$HOME/.curlrc" && grep -qx 'stderr -' "$HOME/.curlrc"; then
  leak=1
fi
# Record what curl would read from stdin or from a config/header file, on
# separate lines so tests can tell argv apart from other input channels.
prev=""
for a in "$@"; do
  case "$prev:$a" in
    -K:- | --config:- | -H:@- | --header:@-)
      stdin="$(cat || true)"
      [ -z "$stdin" ] || printf '%s\n' "$stdin" | sed 's/^/curl-stdin /' >>"${NS_STUB_LOG:-/dev/null}"
      [ "$leak" = 0 ] || [ -z "$stdin" ] || printf '%s\n' "$stdin" | sed 's/^/> /'
      ;;
    -K:* | --config:*)
      [ ! -f "$a" ] || sed 's/^/curl-file /' "$a" >>"${NS_STUB_LOG:-/dev/null}"
      ;;
    -H:@* | --header:@*)
      [ ! -f "${a#@}" ] || sed 's/^/curl-file /' "${a#@}" >>"${NS_STUB_LOG:-/dev/null}"
      ;;
  esac
  prev="$a"
done
for a in "$@"; do
  if [ "$a" = -w ]; then
    printf '%s' "${CURL_STUB_HTTP_CODE:-200}"
    break
  fi
done
[ -z "${CURL_STUB_STDERR:-}" ] || printf '%s\n' "$CURL_STUB_STDERR" >&2
exit "${CURL_STUB_EXIT:-0}"
