#!/usr/bin/env bash
set -euo pipefail

root="${NS_LINT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$root"

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  echo "usage: tests/lint"
  echo "Run shellcheck on every bash file under bin/, plugins/ and tests/."
  exit 0
fi

files=()
for dir in bin plugins tests; do
  [ -d "$dir" ] || continue
  while IFS= read -r -d '' f; do
    case "$f" in tests/fixtures/sandbox-base/*) continue ;; esac
    first=""
    IFS= read -r first <"$f" || true
    case "$f" in
      *.sh|*.bash) files+=("$f") ;;
      *) if [[ "$first" =~ ^#!.*(/|[[:space:]])bash([[:space:]]|$) ]]; then files+=("$f"); fi ;;
    esac
  done < <(find "$dir" -type f -print0 | sort -z)
done

# bin/lib/*.sh are sourced libraries: force the shell dialect
libs=()
others=()
for f in "${files[@]}"; do
  case "$f" in bin/lib/*.sh) libs+=("$f") ;; *) others+=("$f") ;; esac
done

rc=0
if [ "${#others[@]}" -gt 0 ]; then
  shellcheck -x "${others[@]}" || rc=1
fi
if [ "${#libs[@]}" -gt 0 ]; then
  shellcheck -x --shell=bash "${libs[@]}" || rc=1
fi

# jq-compat (ns-105): CI runs jq 1.7.1. A reduce/foreach expression used
# directly as a binding source, `reduce .[] as $x (INIT; UPDATE) as $roots`,
# must be parenthesised: `(reduce ... ) as $roots` (see fix/ns-84). jq 1.8.1
# accepts the bare form, 1.7.x rejects it, so a local run cannot catch it.
# Scope: multi-line aware paren matching over file text; comment lines skipped.
CI_JQ_VERSION="1.7.1"
for f in "${files[@]}"; do
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    echo "$f:$line: jq 1.7-incompatible: wrap in parentheses: (reduce/foreach ... ) as \$name" >&2
    rc=1
  done < <(python3 - "$f" <<'PY'
import re, sys
text = "".join("\n" if l.lstrip().startswith("#") else l
               for l in open(sys.argv[1], errors="replace").read().splitlines(True))
head = re.compile(r"\b(reduce|foreach)\b")
binder = re.compile(r"\bas\s+(\$\w+|\[[^\]]*\]|\{[^}]*\})\s*\(")
after = re.compile(r"\s*as\s+[$\[{]")
seen = set()
for m in head.finditer(text):
    b = binder.search(text, m.end())
    if not b:
        continue
    i, depth = b.end(), 1
    while i < len(text) and depth:
        depth += {"(": 1, ")": -1}.get(text[i], 0)
        i += 1
    if depth == 0 and after.match(text, i):
        ln = text.count("\n", 0, m.start()) + 1
        if ln not in seen:
            seen.add(ln)
            print(ln)
PY
)
done

if command -v jq >/dev/null 2>&1; then
  local_jq="$(jq --version 2>/dev/null || true)"
  local_jq="${local_jq#jq-}"
  if [ -n "$local_jq" ] && [ "$local_jq" != "$CI_JQ_VERSION" ]; then
    echo "lint: warning: local jq $local_jq differs from CI jq $CI_JQ_VERSION; the syntax rule above is the guard" >&2
    if [ "${NS_LINT_STRICT_JQ:-0}" = "1" ]; then
      rc=1
    fi
  fi
fi

if [ "$rc" -ne 0 ]; then
  exit 1
fi
echo "lint: ok (${#files[@]} files)"
