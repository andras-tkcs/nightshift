#!/usr/bin/env python3
"""Generate docs/profile-reference.md from schema/profile.schema.json."""
import argparse
import json
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
SCHEMA = os.path.join(ROOT, "schema", "profile.schema.json")
DEFAULT_OUT = os.path.join(ROOT, "docs", "profile-reference.md")

HEADER = """# Profile reference

Generated by bin/lib/gen-profile-doc from schema/profile.schema.json. Do not edit by hand.

"""

EXAMPLE = """project: privacyfence
prefix: pf
docs:                          # pointers the agents read
  contributing: CONTRIBUTING.md
  dod: docs/coding-and-testing-guidelines.md#27-definition-of-done
  releasing: docs/releasing.md
commands:                      # per stack defaults can be overridden here
  test: .venv/bin/pytest -q
  lint: .venv/bin/ruff check .
git:
  base_branch: main            # where PRs go; e2e tests point this at a throwaway branch
  plan_branch: "plan/{slug}"
  feature_branch: "feature/{n}"
  phase_branch: "feature/{n}--{phase}"
  merge: "--no-ff"
  phase_trailer: "Plan-Phase"
  plan_doc: "docs/{slug}-plan.md"
worktrees: "~/Coding/worktrees/{repo}-{slug}"
stacks:
  - { name: python, paths: ["src/", "tests/", "scripts/*.py"] }
platforms:
  linux:   { verify: local }
  macos:   { verify: ci, workflows: [build.yml] }
  windows: { verify: ci, workflows: [build.yml] }
platform_paths:
  macos:   ["**/*macos*"]
  windows: ["installer/**"]
ci:
  dispatch_only_from_main: true
  workflows:
    qa-record-fixture.yml: { input: connector, needs_approval: true }
    build.yml: {}
risk_zones:
  policy: { paths: ["src/**/policy/**"], require: [sec-compliance] }
protected_paths: [".github/workflows/**", "credentials/**"]
specialists: []                # Build B: database-expert, data-analyst, ui-ux-designer
domain_skills: [pf-invariants]
budgets:                       # optional per-project override of section 7 defaults
  T3: { hours: 36 }
"""


def cell(text):
    return str(text).replace("|", "\\|").replace("\n", " ")


def code(text):
    return "`" + str(text) + "`"


def type_text(node):
    t = node.get("type")
    if "anyOf" in node:
        t = " or ".join(type_text(n) for n in node["anyOf"])
    elif t == "array":
        items = node.get("items", {})
        t = "array of " + type_text(items)
        if "minItems" in node:
            t += f", at least {node['minItems']}"
    elif isinstance(t, list):
        t = " or ".join(t)
    extra = []
    if "const" in node:
        extra.append("const " + code(node["const"]))
    if "enum" in node:
        extra.append("one of " + ", ".join(code(e) for e in node["enum"]))
    if "pattern" in node:
        extra.append("pattern " + code(node["pattern"]))
    if "exclusiveMinimum" in node:
        extra.append(f"> {node['exclusiveMinimum']}")
    if "minimum" in node and "maximum" in node:
        extra.append(f"{node['minimum']}..{node['maximum']}")
    if "patternProperties" in node:
        pat = next(iter(node["patternProperties"]))
        extra.append("keys matching " + code(pat))
    return t + ("; " + "; ".join(extra) if extra else "")


def default_text(node, required):
    if required:
        return "required"
    if "default" in node:
        return code(json.dumps(node["default"], separators=(", ", ": ")))
    return "none"


def rows(node, path, required, out):
    out.append((path, type_text(node), default_text(node, required),
                "yes" if required else "no", node.get("description", "")))
    children = []
    if "properties" in node:
        req = set(node.get("required", []))
        for name, sub in node["properties"].items():
            children.append((f"{path}.{name}" if path else name, sub, name in req))
    if "patternProperties" in node:
        key = node.get("x-key", "key")
        for sub in node["patternProperties"].values():
            children.append((f"{path}.<{key}>", sub, False))
    items = node.get("items")
    if items:
        for alt in items.get("anyOf", [items]):
            if alt.get("type") == "object":
                req = set(alt.get("required", []))
                for name, sub in alt.get("properties", {}).items():
                    children.append((f"{path}[].{name}", sub, name in req))
            elif alt.get("type") == "array":
                pass
    for child_path, sub, req in children:
        rows(sub, child_path, req, out)


def render():
    with open(SCHEMA, encoding="utf-8") as fh:
        schema = json.load(fh)
    out = []
    req = set(schema.get("required", []))
    for name, sub in schema["properties"].items():
        rows(sub, name, name in req, out)
    lines = [HEADER.rstrip("\n"), "",
             "| Key | Type | Default | Required | Description |",
             "|---|---|---|---|---|"]
    for key, typ, default, required, desc in out:
        lines.append(f"| {code(key)} | {cell(typ)} | {cell(default)} | {required} | {cell(desc)} |")
    lines += ["", "## Example", "", "```yaml", EXAMPLE.rstrip("\n"), "```", ""]
    return "\n".join(lines)


def main(argv):
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--output", default=DEFAULT_OUT, help="file to write or check")
    ap.add_argument("--check", action="store_true", help="exit 1 if the file differs")
    args = ap.parse_args(argv)
    text = render()
    if args.check:
        try:
            with open(args.output, encoding="utf-8") as fh:
                current = fh.read()
        except OSError:
            current = None
        if current != text:
            print("docs/profile-reference.md is stale: run bin/lib/gen-profile-doc")
            return 1
        return 0
    with open(args.output, "w", encoding="utf-8") as fh:
        fh.write(text)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
