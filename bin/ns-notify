#!/usr/bin/env bash
# ns-notify: send a push notification through ntfy. See docs/usage.md.
set -euo pipefail

NS_HOME="${NS_HOME:-$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")}"
export NS_HOME
export NS_CMD="ns-notify"
# shellcheck source=/dev/null
source "$NS_HOME/bin/lib/common.sh"

if [ $# -lt 1 ] || [ $# -gt 2 ]; then
  ns_usage 'ns-notify "<text>" [url]'
fi
text="$1"
url="${2:-}"

ns_load_env
if [ -z "${NS_NTFY_TOPIC:-}" ]; then
  printf 'ns-notify: NS_NTFY_TOPIC is not set; not sent\n' >&2
  exit 0
fi
if ns_has_token "$text" || ns_has_token "$url"; then
  ns_die "refusing to send something that looks like a token"
fi
text="${text:0:200}"

args=(-sS -m 10 -o /dev/null -w '%{http_code}' -H "Title: Nightshift")
[ -z "$url" ] || args+=(-H "Click: $url")
args+=(--data-raw "$text")
endpoint="${NS_NTFY_URL:-https://ntfy.sh}/$NS_NTFY_TOPIC"
token_file="$(ns_config_dir)/tokens/ntfy"
token=""
[ ! -r "$token_file" ] || token="$(tr -d '[:space:]' <"$token_file")"
# The token goes to curl as a config on stdin, never in argv.
if [ -n "$token" ]; then
  args+=(-K - "$endpoint")
  code="$(printf 'header = "Authorization: Bearer %s"\n' "$token" | curl "${args[@]}" 2>/dev/null)" ||
    ns_die "could not reach ntfy"
else
  args+=("$endpoint")
  code="$(curl "${args[@]}" 2>/dev/null </dev/null)" || ns_die "could not reach ntfy"
fi
case "$code" in
  2??) ;;
  *) ns_die "ntfy answered HTTP $code; not sent" ;;
esac
