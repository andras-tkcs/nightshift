#!/usr/bin/env bash
# ns-notify: send a push notification through ntfy. See docs/usage.md.
set -euo pipefail

NS_HOME="${NS_HOME:-$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")}"
export NS_HOME
export NS_CMD="ns-notify"
# shellcheck source=/dev/null
source "$NS_HOME/bin/lib/common.sh"

if [ $# -lt 1 ] || [ $# -gt 2 ]; then
  ns_usage 'ns-notify "<text>" [url]'
fi
text="$1"
url="${2:-}"

ns_load_env
if [ -z "${NS_NTFY_TOPIC:-}" ]; then
  printf 'ns-notify: NS_NTFY_TOPIC is not set; not sent\n' >&2
  exit 0
fi
if ns_has_token "$text" || ns_has_token "$url"; then
  ns_die "refusing to send something that looks like a token"
fi
text="${text:0:200}"
priority="${NS_NTFY_PRIORITY:-}"
case "$priority" in
  "" | min | low | default | high | max | [1-5]) ;;
  *) ns_die "NS_NTFY_PRIORITY must be one of min low default high max 1 2 3 4 5" 2 ;;
esac

# -q first: curl must not read ~/.curlrc (verbose or stderr there would put the token in
# the output).
args=(-q -sS -m 10 -o /dev/null -w '%{http_code}' -H "Title: Nightshift")
[ -z "$url" ] || args+=(-H "Click: $url")
[ -z "$priority" ] || args+=(-H "Priority: $priority")
args+=(--data-raw "$text")
endpoint="${NS_NTFY_URL:-https://ntfy.sh}/$NS_NTFY_TOPIC"
# The token is only for your own ntfy: never sent to ntfy.sh (NS_NTFY_URL unset or ntfy.sh),
# which then gets the message without it. Otherwise dies on a token file that is not
# mode 600 or not an ntfy token.
token=""
if ns_ntfy_public "${NS_NTFY_URL:-}"; then
  [ ! -e "$(ns_config_dir)/tokens/ntfy" ] ||
    ns_warn "not sending the ntfy token to ntfy.sh; set NS_NTFY_URL to your own ntfy"
else
  token="$(ns_ntfy_token)"
fi
errfile="$(mktemp)"
trap 'rm -f "$errfile"' EXIT
# The token goes to curl as a config on stdin, never in argv. curl's stderr goes to a
# file so its error line can be shown after ours; it never holds the token.
rc=0
if [ -n "$token" ]; then
  args+=(-K - "$endpoint")
  code="$(printf 'header = "Authorization: Bearer %s"\n' "$token" | curl "${args[@]}" 2>"$errfile")" || rc=$?
else
  args+=("$endpoint")
  code="$(curl "${args[@]}" 2>"$errfile" </dev/null)" || rc=$?
fi
if [ "$rc" -ne 0 ]; then
  printf 'ns-notify: could not reach ntfy\n' >&2
  reason="$(grep -m1 . "$errfile" || true)"
  [ -z "$token" ] || reason="${reason//"$token"/[token]}"
  [ -z "$reason" ] || printf '%s\n' "$reason" >&2
  exit 1
fi
[[ $code =~ ^[0-9]{3}$ ]] || code="?"
case "$code" in
  2??) ;;
  *) ns_die "ntfy answered HTTP $code; not sent" ;;
esac
