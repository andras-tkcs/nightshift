#!/usr/bin/env bash
# ns-launch: run the conductor session of one run, headless. Started by ns new and ns resume
# inside tmux. Never prints the token.
set -euo pipefail

NS_HOME="${NS_HOME:-$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")}"
export NS_HOME
export NS_CMD="ns-launch"
# shellcheck source=/dev/null
source "$NS_HOME/bin/lib/common.sh"
# shellcheck source=/dev/null
source "$NS_HOME/bin/lib/config.sh"
# shellcheck source=/dev/null
source "$NS_HOME/bin/lib/runs.sh"
# shellcheck source=/dev/null
source "$NS_HOME/bin/lib/profile.sh"

usage() {
  printf 'usage: ns-launch <id> [--triage|--resume]\n\n'
  printf 'Run the conductor session of run <id> headless in its worktree, logging the\n'
  printf "stream to \$NS_CONFIG_DIR/logs/<id>/conductor.jsonl.\n"
}

# after_conductor: the conductor session ended while the run is still running with no gate. When
# its own last result is a usage limit (it shares the account with its workers), or wait had
# already paused the budget on one, park the run so ns health-check resumes it after
# budget.paused_until; a limit that does not reset escalates to gate 1.5 (R-BUD-2).
after_conductor() {
  local state res cls kind=none until=- msg="" now n backoff pu run_dir
  state=$(ns-ledger get "$ledger" '[.state, (.gate // "-")] | join(" ")')
  [ "$state" = "running -" ] || return 0
  res=$(tail -n +"$((lines0 + 1))" "$log" 2>/dev/null | jq -R -c 'fromjson? | select(.type == "result")' 2>/dev/null | tail -n1) || res=""
  now=$(date -u -d "$(ns_now)" +%s)
  if [ -n "$res" ]; then
    cls=$(python3 "$NS_HOME/bin/lib/usage_limit.py" "$now" <<<"$res") || cls=none
    IFS=$'\t' read -r kind until msg <<<"$cls" || true
  fi
  case "$kind" in
    usage-final)
      ns-conductor stop "$id" >/dev/null || true
      run_dir="$wt/.nightshift/runs/$id"
      mkdir -p "$run_dir"
      {
        printf '# Escalation: %s hit a usage limit that does not reset\n\n' "$id"
        printf 'The conductor session ended on this message from Claude Code:\n\n> %s\n\n' "$msg"
        printf 'The run is waiting with its budget paused. Raise the limit or add usage credits, then approve to continue, or stop the run.\n\n'
        printf "## Owner's answer\n\n"
      } >"$run_dir/escalation.md"
      ns-ledger set "$ledger" '.budget.paused = true | .budget.paused_until = null'
      ns-ledger event "$ledger" usage-pause "conductor hit a usage limit; escalate: $msg"
      ns-conductor gate "$id" 1.5 RUN/escalation.md
      ;;
    usage)
      if ! [[ $until =~ ^[0-9]+$ ]]; then
        # conductor limits since the last resume: 15 min, doubling, at most 4 h
        n=$(ns-ledger get "$ledger" '[.events[] | select(.type == "usage-resume" or (.type == "usage-pause" and (.note | startswith("conductor hit")))) | .type] | reverse | (index("usage-resume") // length)')
        backoff=$((900 << n))
        [ "$backoff" -le 14400 ] || backoff=14400
        until=$((now + backoff))
      fi
      pu=$(ns-ledger get "$ledger" '.budget.paused_until // ""')
      if [ -n "$pu" ] && [ "$(date -u -d "$pu" +%s)" -gt "$until" ]; then
        until=$(date -u -d "$pu" +%s)
      fi
      pu=$(date -u -d "@$until" +%Y-%m-%dT%H:%M:%SZ)
      ns-ledger set "$ledger" ".budget.paused = true | .budget.paused_until = \"$pu\""
      ns-ledger event "$ledger" usage-pause "conductor hit a usage limit; paused until $pu: $msg"
      ns-conductor park "$id"
      ;;
    *)
      pu=$(ns-ledger get "$ledger" 'if .budget.paused then (.budget.paused_until // "") else "" end')
      [ -n "$pu" ] || return 0
      ns-ledger event "$ledger" note "conductor ended during a usage pause until $pu; parked"
      ns-conductor park "$id"
      ;;
  esac
}

id=""
mode=""
while [ $# -gt 0 ]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    --triage | --resume)
      mode="$1"
      shift
      ;;
    -*) ns_usage "ns-launch <id> [--triage|--resume]" ;;
    *)
      [ -z "$id" ] || ns_usage "ns-launch <id> [--triage|--resume]"
      id="$1"
      shift
      ;;
  esac
done
[ -n "$id" ] || ns_usage "ns-launch <id> [--triage|--resume]"

ns_load_env
run=$(ns_run_get "$id") || ns_die "unknown run $id"
pname=$(jq -r .project <<<"$run")
wt=$(jq -r .worktree <<<"$run")
project=$(ns_project_by_name "$pname") || ns_die "unknown project $pname"
repo=$(jq -r .repo <<<"$project")
ledger=$(ns_run_ledger "$id")
if [ -f "$ledger" ] && [ -z "${NS_LAUNCH_PINNED:-}" ]; then
  rhome=$(ns_release_home "$ledger") || exit 1
  if [ -n "$rhome" ] && ! [ "$rhome" -ef "$NS_HOME" ]; then
    NS_HOME="$rhome" NS_LAUNCH_PINNED=1 exec "$rhome/bin/ns-launch" "$id" ${mode:+"$mode"}
  fi
fi
ns_token_export "${repo%%/*}"
export NS_RUN_ID="$id"
export NS_LEDGER="$ledger"
export NS_RUN_HOME="$NS_HOME"
export NS_PROJECT="$pname"
export PATH="$NS_HOME/bin:$PATH"
NS_WORKER_MODE="${NS_WORKER_MODE:-$(ns_config_get worker_mode auto)}"
export NS_WORKER_MODE
export BASH_DEFAULT_TIMEOUT_MS=600000
export BASH_MAX_TIMEOUT_MS=600000

prompt="/ns:run $id"
[ "$mode" != --triage ] || prompt="$prompt --triage-only"
[ "$mode" != --resume ] || prompt="$prompt --resume"
[[ $id != *-onboard ]] || prompt="$prompt --onboard"

rc=0
profile=$(ns_profile_json "$(jq -r .path <<<"$project")" "$(jq -r .prefix <<<"$project")" "$(jq -r '.branch // ""' <<<"$project")" 2>/dev/null) || rc=$?
model=sonnet
if [ "$rc" -eq 0 ] || [ "$rc" -eq 3 ]; then
  model=$(jq -r '.agents.conductor.model // "sonnet"' <<<"$profile")
fi

mapfile -t plugin_args < <(ns_plugin_args)

log="$(ns_config_dir)/logs/$id/conductor.jsonl"
mkdir -p "$(dirname "$log")"

cd "$wt"
lines0=0
[ ! -f "$log" ] || lines0=$(wc -l <"$log")
rc=0
"${NS_CLAUDE:-claude}" -p --permission-mode "$NS_WORKER_MODE" --output-format stream-json --verbose \
  --model "$model" --agent ns:conductor "${plugin_args[@]}" "$prompt" \
  < /dev/null > >(tee -a "$log" | python3 "$NS_HOME/bin/lib/stream-view.py") || rc=$?
wait || true
if [ "$mode" != --triage ] && [ -f "$ledger" ]; then
  after_conductor || ns_warn "could not record the end of the conductor session"
fi
# the conductor ended: let the next queued run take the slot
if [ "$mode" != --triage ]; then
  # clean environment: the ending run's token and ids must not reach other runs' conductors
  mkdir -p "$(ns_config_dir)/logs/$id"
  (umask 077 && : >>"$(ns_config_dir)/logs/$id/dequeue.log")
  env -u GH_TOKEN -u NS_RUN_ID -u NS_LEDGER -u NS_PROJECT NS_QUEUE_EXCLUDE="$id" \
    "$NS_HOME/bin/ns" dequeue >>"$(ns_config_dir)/logs/$id/dequeue.log" 2>&1 || true
fi
exit "$rc"
